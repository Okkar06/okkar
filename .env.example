# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. .env is git-ignored and must never be
# committed. Every variable the app reads is listed here with a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Postgres connection string (keep sslmode=require for hosted databases).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Comma-separated list of browser origins allowed to call the API.
# Never use "*". CLIENT_ORIGIN below is the older single-origin name and is
# still honoured, but ALLOWED_ORIGINS is preferred.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
CLIENT_ORIGIN=https://your-frontend.onrender.com

# Number of reverse proxies in front of the app (Render = 1, bare metal = 0).
# Must not be "true": that would let any caller spoof X-Forwarded-For and
# bypass the rate limiters.
TRUST_PROXY=1

# Maximum accepted JSON request body.
JSON_BODY_LIMIT=10kb

# General API rate limit.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Stricter limit for the contact endpoint.
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Set to "false" to run the API without serving the built client from
# client/dist (useful when the frontend is deployed separately).
SERVE_CLIENT=true

# ── Frontend (build-time, public — never put a secret in a VITE_ variable) ───
# Leave empty to call the API on the same origin.
VITE_API_BASE_URL=https://your-backend.onrender.com
